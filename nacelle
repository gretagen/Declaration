#!/usr/bin/env bash

set -e

# -v/--verbose may appear anywhere in the arguments: pull it out and export
# NACELLE_VERBOSE so the lua side can switch its diagnostics on.
VERBOSE_ARGS=()
for a in "$@"; do
    case "$a" in
        -v|--verbose) export NACELLE_VERBOSE=1 ;;
        --repower)
            echo "nacelle: --repower is an action now, not an option."
            echo "Usage: nacelle repower {house|system} [/path]"
            exit 1
            ;;
        *) VERBOSE_ARGS+=("$a") ;;
    esac
done
set -- "${VERBOSE_ARGS[@]}"

# Install prefix. NACELLE_LIB points the CLI at another tree, so a working
# copy can be tested without repacking the nacelle package.
LIB="${NACELLE_LIB:-/home/gretagen/nacelle}"
# also visible to the lua side, which resolves generators against it
export NACELLE_LIB="$LIB"

# `repower` is the same dispatch as `spin`, with NACELLE_REPOWER exported so
# the planners bypass their "already satisfied" gates. Rewritten before the
# case below so privilege checks, targets and paths are handled in one place.
ACTION=spin
if [ "$1" = "repower" ]; then
    export NACELLE_REPOWER=1
    ACTION=repower
    set -- spin "${@:2}"
fi

if [ $# -eq 0 ]; then
    echo "nacelle: I don't know what to synchronize."
    echo "Usage: nacelle spin {house|system} [/path]"
    echo "       nacelle repower {house|system} [/path]"
    exit 1
fi

case "$1" in
    spin)
        case "$2" in
            house)
                if [ "$EUID" -ne 0 ]; then
                    echo "You are synchronizing the house without privileges."
                    echo "If there are system paths, they will not be modified, and a generation won't be created."
                    echo "Proceed with caution."
                else
                    echo "Please verify what's in the house before synchronizing it as root."
                    echo "We will not be responsible of the damage a house will do to your system."
                    echo "Proceed with caution."
                fi
                sleep 2
                exec lua "$LIB/house-handlers/house_sync.lua" "${@:3}"
                ;;

            system)
                if [ "$EUID" -ne 0 ]; then
                    echo "nacelle: '$ACTION system' needs superuser privileges."
                    exit 1
                fi
                exec lua "$LIB/sync.lua" "${@:3}"
                ;;

            "")
                echo "nacelle: $ACTION needs a target: house or system."
                echo "Usage: nacelle $ACTION {house|system} [/path]"
                exit 1
                ;;

            *)
                echo "Error: I don't know what to $ACTION with '$2'."
                echo "Run nacelle help"
                exit 1
                ;;
                
        esac
        ;;

    see-enabled)
        exec lua "$LIB/plugins.lua"
        ;;

    help)
        cat << 'EOF'
nacelle : Haliade declarative system and home handlers.

Usage: nacelle [action] {category} [/path/to/file.lua] []

Categories:
  house                  Home (dotfiles, local state)
  system                 System definition

Actions
  help                   Show this help
  spin                   Synchronize a category
  repower                Rebuild a category: reapply and rebuild everything,
                         not only what changed — zeta -Solve then -ReProvide
                         for declared packages, every house edit reapplied,
                         every service re-enabled
  see-enabled            See enabled generators
  
Options:
  --verbose          Print the [v] diagnostics (planner progress,
                         file reads, shell commands). Errors are always
                         printed.
  --no-generation

Synchronizing the system needs superuser privileges;
synchronizing the house does not, but will give the user a warning.
EOF
        ;;

    *)
        echo "Error: Unknown command '$1'"
        echo "Run nacelle help"
        exit 1
        ;;
esac
